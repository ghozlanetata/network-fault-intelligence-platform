NFI_DATABASE_PATH=./data/nfi.sqlite3
NFI_MODEL_DIR=./models
NFI_LOG_LEVEL=INFO
NFI_SESSION_TTL=28800
NFI_COOKIE_SECURE=false
NFI_COOKIE_SAMESITE=lax
# Set both to create the first local account on startup; remove after bootstrap.
# NFI_BOOTSTRAP_USERNAME=operator
# NFI_BOOTSTRAP_PASSWORD=<set-a-unique-secret-outside-source-control>
# Defaults to operator. Set only through trusted server-side configuration for initial setup.
# NFI_BOOTSTRAP_ROLE=operator
